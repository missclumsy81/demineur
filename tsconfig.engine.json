// Moteur (src/engine) compilé sans API d'environnement : ni DOM, ni Node, ni Vite (ADR-0002).
{
  "extends": ["@vue/tsconfig/tsconfig.json", "./tsconfig.base.json"],
  "include": ["src/engine/**/*"],
  "compilerOptions": {
    // ECMAScript seul : sans `lib` explicite, la cible ESNext chargerait aussi DOM.
    "lib": ["ES2022"],

    // Aucun paquet `@types/*` global (Node, Vite…).
    "types": [],

    // `vue-tsc --build` produces a .tsbuildinfo file for incremental type-checking.
    // Specified here to keep it out of the root directory.
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.engine.tsbuildinfo"
  }
}
